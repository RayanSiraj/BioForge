# ---- Supabase ----
# Project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Used by API routes that write seed data / bypass RLS for MVP.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- HuggingFace Inference API (ESM-2 scoring) ----
# Create a token at https://huggingface.co/settings/tokens (read scope is enough).
# If this is unset, the ESM-2 module falls back to a deterministic local mock
# so the app still works end-to-end in development.
HF_API_TOKEN=hf_your_token_here

# ESM-2 model to use for scoring. The small model is fast and free-tier friendly.
# Options: facebook/esm2_t6_8M_UR50D (small, default),
#          facebook/esm2_t12_35M_UR50D, facebook/esm2_t33_650M_UR50D (larger).
ESM2_MODEL=facebook/esm2_t6_8M_UR50D
